Options -Multiviews

# Block access to .env and hidden dot files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<Files ".env*">
    Order allow,deny
    Deny from all
</Files>

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

