# ==============================================================================
# ENVIRONMENT CONFIGURATION - SISTEM ABSENSI SMK NU WARGABINANGUN
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Notifikasi Telegram Bot (Opsional)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_NOTIFICATIONS_ENABLED=false

# ------------------------------------------------------------------------------
# 2. Konfigurasi Multi-Provider AI (Chatbot Asisten Pintar Presensi SMK)
# Provider yang didukung: gemini | openai | openrouter
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=350
AI_STATUS=active
